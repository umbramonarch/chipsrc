root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{rs,py,ps1,c,h,cpp,hpp}]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,md,ts,js}]
indent_style = space
indent_size = 2

[*.tsv]
indent_style = tab
trim_trailing_whitespace = false
