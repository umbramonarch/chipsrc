{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/post_edit_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/post_edit_hook.py\""
          }
        ]
      }
    ]
  }
}
